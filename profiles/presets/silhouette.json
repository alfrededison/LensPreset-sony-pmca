{
  "$schema": "../schema/preset.schema.json",
  "id": "silhouette",
  "order": 40,
  "name": { "en": "Backlight / silhouette", "vi": "Ngược sáng / silhouette" },
  "description": {
    "en": "Spot-meter the bright sky and pull exposure down so the subject turns into a clean dark shape.",
