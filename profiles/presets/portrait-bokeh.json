{
  "$schema": "../schema/preset.schema.json",
  "id": "portrait-bokeh",
  "order": 20,
  "name": { "en": "Portrait, blurred background", "vi": "1 người xoá phông" },
  "description": {
    "en": "Wide open but kept a little safe so the eyes stay sharp; eye or face focus when the body has it.",
    "vi": "Mở khẩu lớn nhưng chừa an toàn để mắt vẫn nét; lấy nét mắt hoặc mặt nếu máy hỗ trợ."
  },
  "goal": "shallow_dof",
  "exposure_mode": "aperture_priority",
  "aperture": { "strategy": "widest_safe", "stop_down_from_max": 0.67 },
  "shutter": { "strategy": "handheld_min", "min": "1/125" },
  "iso": "auto",
  "metering": "multi",
  "af": { "mode": "single", "area": "center", "face": true, "eye": "if_available" },
  "drive": { "mode": "single" },
  "style": { "creative_style": "portrait", "fallback": "standard", "soft_skin": "low" },
  "subject": { "framing": "half_body" },
  "hints": ["background_far", "focus_on_eyes"],
  "overlays": ["thirds"]
}
