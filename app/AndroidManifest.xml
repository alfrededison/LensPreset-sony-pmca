<?xml version="1.0" encoding="utf-8"?>
<!-- versionName is the only version in the tree and the next release, unless tools/release.sh is
     given patch, minor or major to bump it first. tools/release.sh is the only thing that rewrites
     it; build.sh derives versionCode and the -dev.N suffix itself. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lenspreset"
    android:versionCode="1"
    android:versionName="1.2.0">
    <uses-sdk android:minSdkVersion="10" android:targetSdkVersion="10" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- LENSPRST on the memory card: profiles to load, PROBE.TXT and LOG.TXT to write. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <application android:label="@string/app_name" android:icon="@drawable/ic_launcher">
        <activity android:name=".app.MainActivity" android:label="@string/app_name"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
